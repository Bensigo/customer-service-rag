# Anthropic API key (required) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Claude model used for generation
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite database path (chunk store + BM25 index)
DB_PATH=data/rag.sqlite3

# Qdrant vector database
QDRANT_URL=http://localhost:6333

# Redis (response cache + conversation sessions)
REDIS_URL=redis://localhost:6379/0

# Response cache TTL in seconds
CACHE_TTL_SECONDS=3600

# Max document upload size in bytes (5 MB)
MAX_UPLOAD_BYTES=5000000
