# Generation backend: "ollama" (default, no API key) or "anthropic"
LLM_PROVIDER=ollama

# Ollama model used for generation (LLM_PROVIDER=ollama)
OLLAMA_MODEL=gemma4

# Anthropic API key — required only when LLM_PROVIDER=anthropic
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Claude model used for generation (LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite database path (chunk store + BM25 index)
DB_PATH=data/rag.sqlite3

# Qdrant vector database
QDRANT_URL=http://localhost:6333

# Qdrant collection holding chunk embeddings
QDRANT_COLLECTION=chunks

# Redis (response cache + conversation sessions)
REDIS_URL=redis://localhost:6379/0

# Response cache TTL in seconds
CACHE_TTL_SECONDS=3600

# Max document upload size in bytes (5 MB)
MAX_UPLOAD_BYTES=5000000

# Ollama server (embeddings) — runs on the host, not in compose
OLLAMA_BASE_URL=http://localhost:11434

# Ollama embedding model (small/fast alternative: nomic-embed-text)
OLLAMA_EMBED_MODEL=qwen3-embedding

# Ollama model used for LLM pointwise reranking (defaults to the generation model)
OLLAMA_RERANK_MODEL=gemma4
